{
  "manifest_version": 3,
  "name": "Gauge — Sales Navigator grader",
  "short_name": "Gauge",
  "version": "0.1.0",
  "description": "How much of your Sales Navigator capacity do you use? Reads your own LinkedIn stats when you click, grades you, sends nothing.",
  "homepage_url": "https://gauge.gershon.ai",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Gauge — grade my Sales Navigator use",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["scripting", "storage"],
  "optional_host_permissions": ["https://www.linkedin.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
