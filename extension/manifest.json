{
  "manifest_version": 3,
  "name": "Gauge — Sales Navigator grader",
  "short_name": "Gauge",
  "version": "0.1.1",
  "description": "See how much of your LinkedIn Sales Navigator capacity you use. One click, one grade. Read-only.",
  "homepage_url": "https://gauge.gershon.ai",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Gauge — grade my Sales Navigator",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://www.linkedin.com/*"]
}
